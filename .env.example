# Slack -> OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack -> Basic Information -> App Credentials -> Signing Secret
# Only needed for HTTP mode (api/index.py on Vercel).
SLACK_SIGNING_SECRET=your-signing-secret

# Slack -> Basic Information -> App-Level Tokens (scope: connections:write)
# Only needed for Socket Mode (socket_mode.py / Docker), not for Vercel.
SLACK_APP_TOKEN=xapp-your-app-token

# Upstash Redis — every rating lives here, so this is not optional.
# Vercel -> Storage -> Upstash for Redis sets these two for you on deploy;
# using Upstash directly, the UPSTASH_REDIS_REST_* pair works too.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-rest-token

# Channel id for the weekly standings post (Slack -> channel -> About -> at the
# bottom). Without it /cron/standings reports no_channel and posts nothing.
TT_CHANNEL=C0123456789

# Shared secret for the /cron/* endpoints. Vercel Cron sends it automatically
# once the project has a CRON_SECRET env var; leave unset to allow any caller.
CRON_SECRET=some-long-random-string
